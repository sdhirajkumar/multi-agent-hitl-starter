# ==============================================================================
# Multi-Agent HITL Starter - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your local or production environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server Settings
# ------------------------------------------------------------------------------
# HOST: Interface host to bind the FastAPI ASGI server.
# Options: 0.0.0.0 (all interfaces), 127.0.0.1 (localhost only).
# Default: 0.0.0.0
# Requirement: Optional
HOST=0.0.0.0

# PORT: Port number for FastAPI.
# Default: 8000
# Requirement: Optional
PORT=8000

# DEBUG: Enable detailed debug logs and reload mode.
# Options: true, false
# Default: false
# Requirement: Optional
DEBUG=false

# ------------------------------------------------------------------------------
# 2. LLM Provider & Model Settings
# ------------------------------------------------------------------------------
# LLM_PROVIDER: Default LLM backend for all agent nodes.
# Options: "mock" (zero-credential simulated demo), "openai", "anthropic", "gemini", "bedrock", "ollama"
# Default: "mock"
# Requirement: Optional (Defaults to "mock" for instant out-of-the-box operation)
LLM_PROVIDER=mock

# MODEL_NAME: Global model name override.
# Options:
#   - For openai: "gpt-4o", "gpt-4o-mini", "o1-mini"
#   - For anthropic: "claude-3-5-sonnet-20241022", "claude-3-5-haiku-20241022"
#   - For gemini: "gemini-1.5-flash", "gemini-1.5-pro", "gemini-2.0-flash"
#   - For bedrock: "anthropic.claude-3-5-sonnet-20240620-v1:0"
#   - For ollama: "llama3:latest", "mistral:latest"
# Default: Provider's primary model
# Requirement: Optional
MODEL_NAME=

# TEMPERATURE: Default generation temperature (0.0 = deterministic, 1.0 = creative).
# Range: 0.0 to 1.0
# Default: 0.7
# Requirement: Optional
TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# 3. Agent Role Model Overrides (Optional Fine-Grained Assignment)
# ------------------------------------------------------------------------------
# Assign a higher reasoning model to the Supervisor and Reviewer, and a faster
# model to the Researcher node.
# Requirement: Optional (Defaults to LLM_PROVIDER standard models if unset)
SUPERVISOR_MODEL=
RESEARCHER_MODEL=
WRITER_MODEL=
REVIEWER_MODEL=

# ------------------------------------------------------------------------------
# 4. Provider API Credentials & Endpoints
# ------------------------------------------------------------------------------
# OPENAI_API_KEY: Required only if LLM_PROVIDER is set to "openai"
# Requirement: Optional (Required if using OpenAI)
OPENAI_API_KEY=

# ANTHROPIC_API_KEY: Required only if LLM_PROVIDER is set to "anthropic"
# Requirement: Optional (Required if using Anthropic)
ANTHROPIC_API_KEY=

# GOOGLE_API_KEY: Required only if LLM_PROVIDER is set to "gemini"
# Requirement: Optional (Required if using Gemini)
GOOGLE_API_KEY=

# AWS Bedrock Credentials (Required only if LLM_PROVIDER is "bedrock")
# Requirement: Optional
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Ollama Endpoint (Required only if LLM_PROVIDER is "ollama")
# Default: http://localhost:11434 (or http://host.docker.internal:11434 in Docker)
# Requirement: Optional
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 5. Checkpointer & Workflow Engine Parameters
# ------------------------------------------------------------------------------
# DATABASE_PATH: Filepath for local zero-setup SQLite checkpointer.
# Default: backend/data/checkpoints.sqlite
# Requirement: Optional
DATABASE_PATH=backend/data/checkpoints.sqlite

# MAX_REVISIONS: Maximum autonomous revision cycles between Critic and Writer
# before forcing the workflow to route to the Human Review Gate.
# Default: 2
# Requirement: Optional
MAX_REVISIONS=2
